# power-report.service — runs the read-only power / thermal report (vcgencmd + PMIC ADC).
# Install mirrors dns-health-check (see layer/ke-25-monitor.yaml): the build copies
# home/scripts/monitoring/power-report.sh -> /usr/local/bin/power-report.sh, drops this unit
# and the timer, and enables the timer. Runs as root, so vcgencmd needs no group video.
# --samples 10 averages ten one-second PMIC reads per run so the hourly trend line is
# steadier than a single instant. --journal-summary keeps the full report in
# /var/log/power-report.log and hands journald one "trend ts=… est_w=…" line per run;
# `journalctl -u power-report` is therefore a compact power history, the file the detail.
# To test a newer copy on a running appliance:
#   sudo cp home/scripts/monitoring/power-report.sh /usr/local/bin/ && sudo chmod 0755 /usr/local/bin/power-report.sh
#   sudo cp etc/systemd/system/power-report.{service,timer} /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now power-report.timer
[Unit]
Description=Power / thermal report (vcgencmd, PMIC ADC, hwmon)

[Service]
Type=oneshot
ExecStart=/usr/local/bin/power-report.sh --samples 10 --journal-summary

[Install]
WantedBy=multi-user.target
