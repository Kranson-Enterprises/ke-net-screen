# net-snapshot.service — runs the read-only nstat/ss snapshot.
# Install mirrors dns-health-check (see layer/ke-25-monitor.yaml): the build copies
# home/scripts/monitoring/net-snapshot.sh -> /usr/local/bin/net-snapshot.sh, drops this unit
# and the timer, and enables the timer. --journal-summary keeps the full report in
# /var/log/net-snapshot.log and hands journald one "snapshot ts=… udp_in=…" line per run;
# `journalctl -u net-snapshot` is therefore a compact counter history, the file the detail.
# To test a newer copy on a running appliance:
#   sudo cp home/scripts/monitoring/net-snapshot.sh /usr/local/bin/ && sudo chmod 0755 /usr/local/bin/net-snapshot.sh
#   sudo cp etc/systemd/system/net-snapshot.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now net-snapshot.timer
[Unit]
Description=Kernel network stats snapshot (nstat/ss)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/net-snapshot.sh --journal-summary

[Install]
WantedBy=multi-user.target
