# Copy this file to .env and adjust values for your environment.
# Keep .env out of version control.

# Required: used for both localadmin password and the initial Pi-hole admin password.
# The Pi-hole password is embedded into a one-time secret file on the boot partition
# during image build, consumed on first boot, and then removed.
# Password requirements (enforced by build layers):
# - minimum 8 characters
# - at least one lowercase letter
# - at least one uppercase letter
# - at least one number
# - at least one special character
# Example valid value: Chang3M@!
PIHOLE_PASSWORD=change-me-now

# Network configuration defaults used by config/ke-net-screen.yaml
NETWORK_INTERFACE=eth0
NETWORK_USE_DHCP=n
NETWORK_IPADDRESS=192.168.0.53
NETWORK_IPNETMASK=24
NETWORK_NETMASK=255.255.255.0
NETWORK_GATEWAY=192.168.0.1
NETWORK_DNS0=127.0.0.1
NETWORK_DNS1=8.8.8.8
NETWORK_DNS2=9.9.9.9
NETWORK_DOMAIN=lan

# Image partition sizing defaults used by config/ke-net-screen.yaml
# Accepted value formats include percent (e.g., 200%) and size suffixes
# such as M or G (e.g., 512M, 115G).
IMAGE_BOOT_PART_SIZE=200%
IMAGE_ROOT_PART_SIZE=500%
# Partition sizes cause size increase to fill device, only needed on final prod deploy
#IMAGE_BOOT_PART_SIZE=512M
#IMAGE_ROOT_PART_SIZE=115G

# Compile source-built Unbound (--source-unbound) with TCP Fast Open server
# support (RFC 7413): adds --enable-tfo-server at configure time so the
# listener accepts DNS-over-TCP queries carried in the SYN. Runtime also
# needs net.ipv4.tcp_fastopen bit 0x2 (etc/sysctl.d/99-unbound-tuning.conf
# already sets 3). Toggling this triggers a full Unbound reconfigure/rebuild.
UNBOUND_ENABLE_TFO_SERVER=n

# Pi-hole regex deny entries imported into gravity.db on first boot, separated by
# semicolons (a regex never needs one). Empty imports nothing. Example that stops
# Windows Web Proxy Auto-Discovery lookups from leaving the LAN: ^wpad\.
# On the appliance, wpad-block.sh --on/--off toggles that entry with a backup.
PIHOLE_REGEX_DENY=

# SSH public key for the localadmin user
# Set to the full content of your SSH public key file (usually ~/.ssh/id_rsa.pub)
# If not set, SSH public-key authentication will not be configured
# To use your local public key: SSH_PUBKEY_USER1="$(cat ~/.ssh/id_rsa.pub)"
SSH_PUBKEY_USER1=

# Unbound source build: extra toolchain hardening (-D_FORTIFY_SOURCE=3 and
# -fstack-clash-protection). The build probes the toolchain first and STOPS if
# it cannot honor the request. Default n: portable to older toolchains.
# Development and production builds on the Pi set this to y.
UNBOUND_EXTRA_HARDENING=n

# Unbound incoming TCP buffers (Pi-hole FTL forwards to Unbound over TCP as well).
# Integer 1-40; 10 is Unbound's own default and writes nothing. 40 removed FTL's TCP
# connection errors, and the REFUSED (EDE 23) answers they caused, on the appliance.
# Above 40 this Unbound build's 1,024-descriptor budget would force a smaller
# outgoing-range, so the build refuses it.
UNBOUND_INCOMING_NUM_TCP=10

# DNS-over-TLS terminator on port 853 (stunnel in front of Pi-hole, using the
# certificate FTL generates itself). Androids with default "Automatic" Private
# DNS then upgrade to encrypted DNS opportunistically, filtering intact, no
# per-phone setup. Default n: nothing installed. Development/production set y.
DOT_TERMINATOR=n

# Hardened TLS on the DoT terminator (only with DOT_TERMINATOR=y). y: key exchange
# offers the ML-KEM-768 + X25519 post-quantum hybrid first, and TLS 1.2 is AEAD-only
# (AES-GCM, ChaCha20-Poly1305; no CBC suites, no SHA-1 MAC). TLS 1.3 is unchanged and
# TLS 1.2 stays available for older clients. Default n: stunnel's defaults (X25519
# first; TLS 1.2 also accepts CBC suites).
DOT_TLS_HARDENING=n

# Optional sysctl hardening. y installs two files under /etc/sysctl.d:
#   60-net-observe.conf   refuse and never send ICMP redirects, strict reverse-path
#                         filter (on eth0 too), log spoofed ("martian") packets
#   61-kernel-harden.conf hide kernel pointers, make dmesg root-only (use sudo dmesg
#                         or journalctl -k)
# Safe on a single-homed appliance. Default n: neither file ships.
SYSCTL_HARDENING=n

# Further kernel restrictions, one toggle each (independent of SYSCTL_HARDENING) so
# each can be trialled and rolled back on its own. Default n: file not shipped,
# kernel default applies. Nothing on the appliance needs what they switch off.
#   SYSCTL_NO_TIOCSTI         62-ke-no-tiocsti.conf: dev.tty.legacy_tiocsti=0 (no
#                             keystroke injection into another session's terminal)
#   SYSCTL_NO_LDISC_AUTOLOAD  63-ke-no-ldisc-autoload.conf: dev.tty.ldisc_autoload=0
#                             (users cannot trigger tty line-discipline module loads)
#   SYSCTL_NO_IO_URING        64-ke-no-io-uring.conf: kernel.io_uring_disabled=2
#                             (io_uring refused for every process; software that
#                             requires it will fail)
SYSCTL_NO_TIOCSTI=n
SYSCTL_NO_LDISC_AUTOLOAD=n
SYSCTL_NO_IO_URING=n

# Full-device discard (FTL/wear-leveling reset) before flashing the SD card, in
# bounded 1 GiB steps with per-step progress. Default 0: the fast 34-sector dd
# wipe only (default build speed). Set 1 before a write-endurance baseline or
# when recycling a card. Trialed 2026-11-07: 119 GB discarded in ~7 s, full-speed
# writes immediately after, no mmc errors. (An UNstepped whole-device discard
# stalled a SanDisk SH32G's mmc host for minutes on 2026-10-17 — that is why
# the step form is hardcoded.) Only read by the interactive flash path.
KE_FLASH_DISCARD=0
